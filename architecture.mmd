flowchart LR
  subgraph sources
    SRC[(Source CSV/API drop)]
    INBOX[(data/raw/inbox/*.csv)]
  end

  subgraph orchestration[Dagster]
    S0[inbox_csv_sensor]
    A1[bronze_ecommerce_transactions]
    A2[silver_ecommerce_transactions]
    A3[dbt_ecommerce_marts]
    S0 --> A1 --> A2 --> A3
  end

  subgraph queue[Redis queue]
    Q1[ecommerce:ingest:queue]
  end

  subgraph spark[PySpark]
    B1[Read CSV\nnormalize schema]
    B2[Hive-partitioned\nbronze Parquet]
    B3[Clean + dedupe\nsilver Parquet]
    B1 --> B2 --> B3
  end

  subgraph dbt[dbt + DuckDB]
    D1[stg_ecommerce_transactions\nread_parquet glob]
    D2[marts:\ndaily revenue + customer rollups]
    D1 --> D2
  end

  SRC --> INBOX
  INBOX --> S0
  S0 --> Q1
  Q1 --> A1
  A1 --> B1
  B2 --> A2
  A2 --> B3
  B3 --> A3
  A3 --> D1
  D2 --> OUT[(DuckDB tables\n+ dbt tests)]
