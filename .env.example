# Copy to .env and adjust. Used by Dagster assets and dbt vars.

# Monotonic run identifier (logged in bronze metadata; default: timestamp-based)
# PIPELINE_RUN_ID=2026-04-11T12-00-00Z

# Absolute or repo-relative path to raw CSV (default: ./ecommerce_customer_data_custom_ratios.csv)
# ECOMMERCE_RAW_CSV_PATH=ecommerce_customer_data_custom_ratios.csv

# Root for Parquet outputs (default: ./data/processed)
# ECOMMERCE_PROCESSED_ROOT=data/processed
