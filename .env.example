# Copy to .env and adjust. Used by Dagster assets and dbt vars.

# Monotonic run identifier (logged in bronze metadata; default: timestamp-based)
# PIPELINE_RUN_ID=2026-04-11T12-00-00Z

# Absolute or repo-relative path to raw CSV (default: data/raw/ecommerce_customer_data_custom_ratios.csv)
# ECOMMERCE_RAW_CSV_PATH=data/raw/ecommerce_customer_data_custom_ratios.csv
# Inbox watched by trigger/sensor (default: data/raw/inbox)
# ECOMMERCE_RAW_INBOX_DIR=data/raw/inbox

# Root for Parquet outputs (default: ./data/processed)
# ECOMMERCE_PROCESSED_ROOT=data/processed

# Redis queue settings (default localhost:6379, queue ecommerce:ingest:queue)
# ECOMMERCE_REDIS_HOST=localhost
# ECOMMERCE_REDIS_PORT=6379
# ECOMMERCE_INGEST_QUEUE=ecommerce:ingest:queue
